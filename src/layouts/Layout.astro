---
import '../styles/global.css';
import info from '../data/info.json';
import WhatsappFloat from '../components/WhatsappFloat.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = info.nombre,
  description = info.descripcion,
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/favicon-180.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Montserrat:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <div class="fondo-foto" aria-hidden="true">
      <img src="/images/fondo.jpg" alt="" />
    </div>
    <div id="fondo-foto-2" class="fondo-foto" aria-hidden="true">
      <img src="/images/fondo-2.jpg" alt="" />
    </div>
    <slot />
    <WhatsappFloat />
    <script>
      function activarRevelado() {
        const elementos = document.querySelectorAll('.reveal');
        const observer = new IntersectionObserver(
          (entradas) => {
            entradas.forEach((entrada) => {
              if (entrada.isIntersecting) {
                entrada.target.classList.add('is-visible');
                observer.unobserve(entrada.target);
              }
            });
          },
          { threshold: 0, rootMargin: '0px 0px -10% 0px' }
        );
        elementos.forEach((el) => observer.observe(el));
      }

      activarRevelado();
      document.addEventListener('astro:page-load', activarRevelado);

      // Crossfade entre las dos fotos de fondo según el scroll: la segunda
      // va apareciendo a medida que se baja por la página.
      function activarCrossfadeFondo() {
        const capa2 = document.getElementById('fondo-foto-2');
        if (!capa2) return;

        let ticking = false;
        function actualizar() {
          ticking = false;
          const recorrido = document.documentElement.scrollHeight - window.innerHeight;
          const progreso = recorrido > 0 ? window.scrollY / recorrido : 0;
          // La transición ocurre en el primer tercio del recorrido de la página.
          const opacidad = Math.min(1, Math.max(0, progreso / 0.33));
          capa2.style.opacity = String(opacidad);
        }
        function solicitarActualizacion() {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(actualizar);
          }
        }

        actualizar();
        window.addEventListener('scroll', solicitarActualizacion, { passive: true });
        window.addEventListener('resize', solicitarActualizacion);
      }

      activarCrossfadeFondo();
      document.addEventListener('astro:page-load', activarCrossfadeFondo);
    </script>
  </body>
</html>
