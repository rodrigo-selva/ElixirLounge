---
import info from '../data/info.json';

const whatsappUrl = `https://wa.me/${info.whatsapp}?text=${encodeURIComponent(info.whatsappMensaje)}`;
---

<a
  href={whatsappUrl}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Escribir por WhatsApp"
  class="pulso-whatsapp fixed bottom-4 right-4 z-50 flex h-12 w-12 items-center justify-center rounded-full bg-green-600 text-white shadow-lg transition hover:scale-105 hover:bg-green-500 sm:bottom-5 sm:right-5 sm:h-14 sm:w-14"
>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" class="h-6 w-6 sm:h-7 sm:w-7" fill="currentColor" aria-hidden="true">
    <path
      d="M16.004 2.667c-7.364 0-13.333 5.97-13.333 13.333 0 2.351.615 4.646 1.783 6.666L2.667 29.333l6.84-1.794a13.27 13.27 0 0 0 6.497 1.694h.006c7.363 0 13.333-5.97 13.333-13.333 0-3.56-1.387-6.907-3.904-9.425a13.24 13.24 0 0 0-9.429-3.908zm0 24.4h-.005a11.03 11.03 0 0 1-5.62-1.538l-.403-.24-4.06 1.065 1.084-3.958-.263-.407a11.02 11.02 0 0 1-1.69-5.869c0-6.106 4.97-11.075 11.082-11.075a11.02 11.02 0 0 1 7.84 3.249 11.02 11.02 0 0 1 3.242 7.834c-.002 6.106-4.97 11.075-11.08 11.075zm6.076-8.292c-.333-.167-1.97-.973-2.276-1.084-.305-.111-.527-.167-.75.167-.222.333-.86 1.084-1.055 1.306-.194.223-.388.25-.722.084-.333-.167-1.407-.519-2.68-1.653-.99-.883-1.66-1.974-1.854-2.307-.194-.334-.02-.514.147-.68.15-.15.333-.39.5-.584.167-.195.222-.334.333-.556.111-.223.055-.417-.028-.584-.084-.167-.75-1.806-1.028-2.474-.27-.65-.545-.562-.75-.572l-.639-.011c-.222 0-.583.083-.889.417-.306.333-1.167 1.14-1.167 2.779s1.195 3.222 1.361 3.445c.167.223 2.352 3.593 5.698 5.039.796.344 1.417.549 1.901.703.799.254 1.527.218 2.103.133.642-.096 1.97-.805 2.248-1.583.278-.778.278-1.445.194-1.584-.083-.138-.305-.222-.639-.389z"
