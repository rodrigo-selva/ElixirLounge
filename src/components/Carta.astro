---
import carta from '../data/carta.json';

const formatearPrecio = (valor: number) =>
  valor.toLocaleString('es-ES', { style: 'currency', currency: 'EUR' });

// Precio sin etiqueta (cerveza, refresco...) o con etiqueta (Chupito, Copa...)
const precioVisible = (precios: { etiqueta?: string; valor: number }[]) =>
  precios.map((p) => ({ etiqueta: p.etiqueta ?? '', texto: formatearPrecio(p.valor) }));
---

<div class="mx-auto max-w-3xl px-4 py-10">
  <nav
    class="sticky z-30 -mx-4 mb-12 flex flex-wrap justify-center gap-3 bg-fondo/90 px-4 py-3 backdrop-blur"
    style="top: var(--header-h, 65px)"
  >
    {carta.categorias.map((categoria) => (
      <a
        href={`#${categoria.id}`}
        data-nav-carta={categoria.id}
        class="rounded-full border border-acento/50 px-4 py-2 text-sm transition hover:bg-acento hover:text-fondo data-[active=true]:bg-acento data-[active=true]:text-fondo"
      >
        {categoria.nombre}
      </a>
    ))}
  </nav>

  {carta.categorias.map((categoria) => (
    <section id={categoria.id} class="reveal mb-16 scroll-mt-32">
      <h2 class="mb-2 text-center font-titulo text-4xl text-acento">{categoria.nombre}</h2>
      {categoria.nota && <p class="mb-6 text-center text-sm text-texto/60">{categoria.nota}</p>}

      {categoria.subcategorias.map((sub) => (
        <div class="mb-10">
          <h3 class="mb-2 border-b border-acento/40 pb-2 font-titulo text-2xl">{sub.nombre}</h3>
          {sub.descripcion && <p class="mb-3 text-sm italic text-texto/60">{sub.descripcion}</p>}

          <ul class="divide-y divide-white/10">
            {sub.productos.map((producto) => (
              <li class="flex items-start justify-between gap-4 rounded-lg px-2 py-3 transition-colors hover:bg-white/5">
                <div>
                  <p class="font-medium">{producto.nombre}</p>
                  {producto.descripcion && (
                    <p class="text-sm text-texto/60">{producto.descripcion}</p>
                  )}
                </div>

                {producto.precios.length === 0 ? (
                  <span class="shrink-0 text-sm italic text-texto/50">Consultar</span>
                ) : (
                  <div class="shrink-0 text-right">
                    {precioVisible(producto.precios).map((p) => (
                      <p class="font-semibold text-acento">
                        {p.etiqueta && <span class="mr-1 text-xs font-normal text-texto/60">{p.etiqueta}</span>}
                        {p.texto}
                      </p>
                    ))}
                  </div>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>
  ))}
</div>

<script>
  function activarNavCarta() {
    const secciones = document.querySelectorAll('section[id]');
    const enlaces = document.querySelectorAll('[data-nav-carta]');
    if (!secciones.length || !enlaces.length) return;

    const observer = new IntersectionObserver(
      (entradas) => {
        entradas.forEach((entrada) => {
          const enlace = document.querySelector(`[data-nav-carta="${entrada.target.id}"]`);
          if (!enlace) return;
          if (entrada.isIntersecting) {
            enlaces.forEach((e) => e.removeAttribute('data-active'));
            enlace.setAttribute('data-active', 'true');
          }
        });
      },
      { rootMargin: '-40% 0px -50% 0px' }
    );

    secciones.forEach((s) => observer.observe(s));
  }

  activarNavCarta();
  document.addEventListener('astro:page-load', activarNavCarta);
</script>
