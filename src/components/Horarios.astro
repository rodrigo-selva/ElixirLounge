---
import info from '../data/info.json';
---

<section class="px-4 py-16">
  <div class="reveal mx-auto max-w-3xl">
    <h2 class="mb-10 text-center font-titulo text-4xl text-acento">Horarios y ubicación</h2>

    <div class="grid gap-10 md:grid-cols-2">
      <div>
        <ul class="space-y-3">
          {info.horarios.map((horario) => (
            <li class="flex justify-between border-b border-white/10 pb-2">
              <span>{horario.dias}</span>
              <span class="font-semibold">{horario.horas}</span>
            </li>
          ))}
        </ul>
        {info.horariosNota && <p class="mt-3 text-sm text-texto/50">{info.horariosNota}</p>}
      </div>

      <div class="flex flex-col items-start gap-4">
        <p class="text-lg">{info.direccion}</p>
        <a
          href={info.mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-full bg-acento px-6 py-3 font-semibold text-fondo transition hover:opacity-90"
        >
          Abrir en Google Maps
        </a>
      </div>
    </div>

    {info.mapsEmbedUrl && (
      <div class="mt-10 overflow-hidden rounded-2xl border border-white/10">
        <iframe
          src={info.mapsEmbedUrl}
          width="100%"
          height="350"
          style="border:0"
          loading="lazy"
          allowfullscreen
          referrerpolicy="no-referrer-when-downgrade"
          title={`Mapa de ubicación de ${info.nombre}`}
        ></iframe>
      </div>
    )}
  </div>
</section>
